# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres (shared by docker-compose and Movies.Api)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movies
POSTGRES_USER=dev-user
POSTGRES_PASSWORD=changeme

# JWT (Identity.Api)
JWT_TOKEN_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=https://id.hammayo.co.uk
JWT_AUDIENCE=https://tewe-movies.hammayo.co.uk

# Movies.Api API key — sent by clients in the x-api-key header
API_KEY=change-me-to-a-random-api-key

# TMDB (fetch-tmdb.sh) — get credentials at https://www.themoviedb.org/settings/api
# Accepts either a v3 API key (32-char hex) or a v4 read-access token (a JWT);
# fetch-tmdb.sh picks the right auth scheme based on the key's shape.
TMDB_API_KEY=your-tmdb-v3-api-key-or-v4-token
