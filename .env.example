# Copy this file to .env and fill in real values. .env is gitignored.
IDENTITY_API_URL=https://localhost:5003
MOVIES_API_URL=https://localhost:5001

# Postgres (shared by docker-compose and Movies.Api)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movies
POSTGRES_USER=dev-user
POSTGRES_PASSWORD=changeme

# Database (Movies.Api). A full Database__ConnectionString overrides the POSTGRES_* parts above.
# SslMode: Disable locally (docker has no TLS); use Require against Azure Flexible Server.
# MigrateOnStartup: true locally; false in Azure (the deploy pipeline migrates instead).
# KeyVault__Uri is Azure-only (secrets via managed identity); leave unset locally.
Database__SslMode=Disable
Database__MigrateOnStartup=true
# Database__ConnectionString=
# KeyVault__Uri=

# JWT (Identity.Api)
JWT_TOKEN_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=https://id.hammayo.co.uk
JWT_AUDIENCE=https://tewe-movies.hammayo.co.uk

# Movies.Api API key — sent by clients in the x-api-key header
API_KEY=change-me-to-a-random-api-key

# TMDB (fetch-tmdb.sh) — get credentials at https://www.themoviedb.org/settings/api
# Accepts either a v3 API key (32-char hex) or a v4 read-access token (a JWT);
# fetch-tmdb.sh picks the right auth scheme based on the key's shape.
TMDB_API_KEY=your-tmdb-v3-api-key-or-v4-token

# Password for the ASP.NET dev cert (.certs/aspnet-dev.pfx) mounted into the
# Docker containers for HTTPS. scripts/stack-up.sh generates the cert with this
# password if it is missing. Any non-empty value works for local dev.
ASPNETCORE_DEV_CERT_PASSWORD=devcert
