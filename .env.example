# Working local-dev defaults — copy to .env and run. Only TMDB_API_KEY needs a real
# value, and only to regenerate data. What each var means: _docs/_getting-started.md
IDENTITY_API_URL=https://localhost:5003
MOVIES_API_URL=https://localhost:5001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movies
POSTGRES_USER=dev-user
POSTGRES_PASSWORD=dev-password

Database__SslMode=Disable
Database__MigrateOnStartup=true
# Database__ConnectionString=
# KeyVault__Uri=

JWT_TOKEN_SECRET=local-dev-only-jwt-signing-secret-change-in-production
JWT_ISSUER=https://localhost:5003
JWT_AUDIENCE=https://localhost:5001

API_KEY=local-dev-api-key

TMDB_API_KEY=your-tmdb-v3-api-key-or-v4-token

ASPNETCORE_DEV_CERT_PASSWORD=devcert

# Only for scripts/sonar-scan.sh (local SonarCloud scan); CI uses the GitHub secret
# SONAR_TOKEN=

# Home-page hero: comma-separated movie slugs, up to five. Empty (or a slug that is missing) falls back to the newest releases.
HERO_SLUGS=the-odyssey-2026,the-invite-2026,encounter-2021,prometheus-2012,pulp-fiction-1994
